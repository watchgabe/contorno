---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 'full' (default) → site Nav. 'minimal' → just the centered wordmark. 'none' → no header. */
  header?: 'full' | 'minimal' | 'none';
  /** Set false to omit the site footer on this page. */
  footer?: boolean;
}

const {
  title = 'contorno',
  description = 'Contorno documents the process of building in Puerto Escondido, México.',
  header = 'full',
  footer = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500;700&family=Gabarito:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {header === 'full' && <Nav />}
    {header === 'minimal' && (
      <nav id="main-nav" class="nav-minimal">
        <a href="/" class="nav-logo">contorno</a>
      </nav>
    )}
    <slot />
    {footer && <Footer />}
  </body>
</html>

<style is:global>
  /* Minimal header: centered wordmark on a cream bar so scrolling
     content doesn't bleed through the otherwise-transparent nav. */
  nav#main-nav.nav-minimal {
    background: var(--cream);
    justify-content: center;
  }
  nav#main-nav.nav-minimal .nav-logo {
    position: static;
    transform: none;
  }
</style>
