---
import BaseLayout from '../layouts/BaseLayout.astro';

// Prestige Booking Channel booking page for the Contorno property (id 343502).
// Embed code generated from the account's Iframe widget.
const BOOKING_URL = 'https://book.prestigebookingchannel.com/booking2.php?propid=343502&referer=iframe';
---

<BaseLayout
  title="Book | Contorno"
  description="Sample booking page for Contorno."
  noindex={true}
>
  <section class="book">
    <p class="book-eyebrow">Bookings</p>
    <h1 class="book-title">book</h1>
    <p class="book-lede">Choose your dates to see what is open.</p>

    <div class="book-frame">
      <iframe
        src={BOOKING_URL}
        title="Contorno booking"
        width="100%"
        height="1800"
        loading="lazy"
        style="max-width:100%;border:none;overflow:auto;"
      >
        <p><a href={BOOKING_URL}>Book now</a></p>
      </iframe>
    </div>

    <p class="book-note">Sample page. Hidden from search and not linked from the site.</p>
  </section>
</BaseLayout>

<style>
  .book {
    padding: calc(var(--nav-h) + 80px) 24px 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .book-eyebrow {
    font-family: var(--label);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 22px;
  }
  .book-title {
    font-family: var(--display);
    font-size: clamp(48px, 8vw, 104px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink);
    margin-bottom: 18px;
    text-transform: lowercase;
  }
  .book-lede {
    font-family: var(--serif);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    color: #4a4a44;
    margin-bottom: 36px;
  }
  .book-frame {
    width: 100%;
    max-width: 1000px;
    border: 1px solid rgba(18, 18, 18, 0.12);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }
  .book-frame iframe {
    display: block;
    width: 100%;
  }
  .book-note {
    margin-top: 20px;
    font-family: var(--label);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a857a;
  }
</style>
