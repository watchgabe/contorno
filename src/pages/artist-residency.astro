---
import BaseLayout from '../layouts/BaseLayout.astro';

// Same questions as before, now all on one page. kind: short | long | email | url
const fields = [
  { k: 'name', req: true, kind: 'short', q: 'Your name', ph: 'First and last name' },
  { k: 'email', req: true, kind: 'email', q: 'Your email address', help: 'This is where we will write to you.', ph: 'name@example.com' },
  { k: 'based', req: true, kind: 'short', q: 'Where you are based right now', ph: 'City, country' },
  { k: 'instagram', kind: 'short', q: 'Your Instagram handle', ph: '@' },
  { k: 'portfolio', req: true, kind: 'url', q: 'Your portfolio or website', ph: 'https://' },
  { k: 'make', req: true, kind: 'long', q: 'What you make', help: 'Medium, subject, the way you work.' },
  { k: 'pieces', req: true, kind: 'long', q: 'Links to 3 to 5 pieces you are proud of', help: 'One link per line. Recent work or work from a few years back, your choice.', ph: 'https://' },
  { k: 'now', kind: 'long', q: 'What you are making right now', help: 'The thing that is pulling you in at the moment.' },
  { k: 'sentence', kind: 'short', q: 'How a friend would describe your work in one sentence' },
  { k: 'why', req: true, kind: 'long', q: 'Why Puerto Escondido, and why now' },
  { k: 'idea', kind: 'long', q: 'A rough idea for the piece you would leave behind', help: 'Residents leave one piece that lives at Contorno. Describe what you might make for a space like this. It is a rough idea and it can change.' },
  { k: 'unlock', kind: 'long', q: 'What a month here would unlock for you' },
  { k: 'notes', kind: 'long', q: 'Anything we should know', help: 'Dietary needs, accessibility, traveling with a partner, working hours.' },
  { k: 'heard', kind: 'short', q: 'How you heard about the residency' },
];
---

<BaseLayout
  title="Artist Residency Program | Contorno"
  description="Inviting artists to live and work on site at Contorno in Puerto Escondido, Oaxaca."
>
  <main class="rs">
    <p class="rs-eyebrow">Artist Residency Program</p>
    <h1 class="rs-title">Inviting artists to live and work on site</h1>

    <div class="rs-panel" id="ap">
      <form id="ap-form" novalidate>
        <p class="ap-intro">The application has {fields.length} short questions and takes about ten minutes. We read every one. Questions marked with * are required.</p>

        {fields.map((f) => (
          <div class="ap-row">
            <label class="ap-label" for={'f-' + f.k}>{f.q}{f.req ? ' *' : ''}</label>
            {f.help && <p class="ap-help" id={'h-' + f.k}>{f.help}</p>}
            {f.kind === 'long' ? (
              <textarea class="ap-field" id={'f-' + f.k} name={f.k} rows="4" placeholder={f.ph || ''} required={f.req} aria-describedby={f.help ? 'h-' + f.k : undefined}></textarea>
            ) : (
              <input class="ap-field" id={'f-' + f.k} name={f.k} type={f.kind === 'email' ? 'email' : 'text'} inputmode={f.kind === 'url' ? 'url' : undefined} placeholder={f.ph || ''} required={f.req} aria-describedby={f.help ? 'h-' + f.k : undefined} />
            )}
            <p class="ap-err" role="alert" data-err={f.k}></p>
          </div>
        ))}

        <div class="ap-trap" aria-hidden="true">
          <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>

        <p class="ap-err ap-err-main" id="ap-err" role="alert"></p>
        <div class="ap-actions">
          <button type="submit" class="ap-ok" id="ap-send">Send application</button>
        </div>
      </form>

      <div class="ap-thanks" id="ap-thanks" hidden>
        <p class="ap-num">Application received</p>
        <h2 id="ap-thanks-h">Thank you</h2>
        <p id="ap-thanks-p">Your application is in. We read every one.</p>
      </div>
    </div>

    <p class="rs-line">1 month on site, 1 hour at a time</p>
  </main>

  <script is:inline src="/apply-form.js" defer></script>
</BaseLayout>

<style is:global>
  .rs { max-width: 920px; margin: 0 auto; padding: calc(var(--nav-h) + 64px) 24px 110px; text-align: center; }
  .rs-eyebrow { font-family: var(--label); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; margin: 0 0 18px; opacity: .75; }
  .rs-title { font-family: var(--display); font-weight: 500; font-size: clamp(36px, 5.6vw, 72px); line-height: 1.02; letter-spacing: -.035em; margin: 0 auto 44px; max-width: 14em; }
  .rs-line { font-family: var(--label); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; margin: 30px 0 0; opacity: .8; }

  /* One page application form */
  .rs-panel { background: var(--offwhite); border: 1px solid rgba(42, 42, 42, .12); border-radius: 12px; text-align: left; padding: clamp(24px, 5vw, 56px); }
  .ap-intro { margin: 0 0 34px; font-size: 16px; line-height: 1.5; max-width: 34em; }
  .ap-row { margin: 0 0 30px; }
  .ap-label { display: block; font-family: var(--display); font-weight: 500; font-size: clamp(19px, 2.2vw, 25px); line-height: 1.15; letter-spacing: -.02em; margin: 0 0 6px; }
  .ap-help { font-size: 14.5px; line-height: 1.45; color: rgba(42, 42, 42, .65); margin: 0 0 10px; max-width: 36em; }
  .ap-field { display: block; width: 100%; font: inherit; font-family: var(--sans); font-size: 17px; color: var(--rust); background: transparent; border: 0; border-bottom: 2px solid rgba(42, 42, 42, .25); padding: 10px 0; border-radius: 0; outline: none; resize: vertical; }
  .ap-field:focus { border-bottom-color: var(--rust); }
  .ap-field::placeholder { color: rgba(42, 42, 42, .3); }
  .ap-field.bad { border-bottom-color: #b3261e; }
  .ap-err { color: #b3261e; font-size: 14px; margin: 8px 0 0; min-height: 0; }
  .ap-err:empty { display: none; }
  .ap-trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .ap-actions { margin-top: 28px; }
  .ap-ok { background: var(--rust); color: #fff; border: 0; border-radius: 4px; padding: 14px 26px; font-family: var(--label); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; cursor: pointer; }
  .ap-ok:hover { background: #a84a2f; }
  .ap-ok:disabled { opacity: .5; cursor: wait; }
  .ap-num { font-family: var(--cx-mono, monospace); font-size: 12px; letter-spacing: .08em; color: var(--rust); margin: 0 0 14px; }
  .ap-thanks[hidden], #ap-form[hidden] { display: none; }
  .ap-thanks h2 { font-family: var(--display); font-weight: 500; font-size: clamp(30px, 4vw, 46px); letter-spacing: -.03em; margin: 0 0 14px; }
  .ap-thanks p { font-size: 17px; line-height: 1.5; margin: 0; max-width: 28em; }
</style>
