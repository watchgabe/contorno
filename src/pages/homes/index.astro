---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { homes } from '../../data/homes';
import '../../styles/booking.css';
const src = (p: string) => encodeURI(p);
---

<BaseLayout title="Find a home | Contorno" description="Homes at Contorno on La Punta, Puerto Escondido." noindex>
  <section class="bl-top">
    <div class="b-wrap">
      <p class="b-eyebrow">Find a home</p>
      <h1>Homes at Contorno</h1>
      <p class="b-lede">La Punta, Puerto Escondido. <span class="ph">[Placeholder: one sentence on minimum stay and how booking works.]</span></p>
      <form class="bl-bar" action="/homes" method="get">
        <div class="bh-field">
          <label for="w">Where to?</label>
          <select id="w" name="where"><option>La Punta, Puerto Escondido</option></select>
        </div>
        <div class="bh-field">
          <label for="ci">When?</label>
          <div style="display:flex; gap:10px;">
            <input id="ci" name="checkin" type="date" aria-label="Check in" />
            <input id="co" name="checkout" type="date" aria-label="Check out" />
          </div>
        </div>
        <div class="bh-field">
          <label for="g">Guests</label>
          <select id="g" name="guests"><option>1 guest</option><option selected>2 guests</option><option>3 guests</option><option>4 guests</option><option>5+ guests</option></select>
        </div>
        <button class="b-btn" type="submit">Search</button>
      </form>
    </div>
  </section>

  <section class="b-section" style="padding-top:8px">
    <div class="b-wrap">
      <div class="bl-count">
        <span class="b-caps">{homes.length} homes</span>
        <span class="b-caps ph">[Availability filter connects here]</span>
      </div>
      <div class="bh-cards">
        {homes.map((h) => (
          <a class="bh-card" href={`/homes/${h.slug}`}>
            <div class="pic">
              <img src={src(h.photos[0])} alt={`Home ${h.name}`} loading="lazy" />
              <span class="tag">{h.name}</span>
            </div>
            <div class="body">
              <h3>{h.name}</h3>
              <span class="b-caps">{h.area}</span>
              <span class="meta">{h.blurb}</span>
              <span class="meta"><span class="ph">{h.beds} | {h.baths} | {h.size}</span></span>
              <span class="price">From <b class="ph">{h.price}</b> / night</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
