---
import BaseLayout from '../layouts/BaseLayout.astro';

const CONTACT_EMAIL = 'hello@contornocollective.com';
const COORDS = '15.8442° N, 97.0418° W';

const homes = [
  {
    href: '/penthouse',
    place: 'PUERTO ESCONDIDO, 2026',
    name: 'the penthouse',
    by: 'BUILT BY NICK PALOUKOS',
    text: 'two bedrooms and a private terrace over the bay, on the top floor of an eight apartment building.',
    img: '/img/home/drone-2.jpg',
    alt: 'Aerial view of the Contorno building with planted terraces',
  },
  {
    href: '/homes/l5',
    place: 'LA PUNTA, 2026',
    name: 'L5',
    by: 'BUILT BY NICK PALOUKOS',
    text: 'quiet rooms with round windows and a view into the jungle canopy.',
    img: '/img/home/ext-2.jpg',
    alt: 'Curved concrete terrace with hanging vines and floor to ceiling curtains',
  },
  {
    href: '/homes/l3',
    place: 'PUERTO ESCONDIDO, 2026',
    name: 'L3',
    by: 'BUILT BY NICK PALOUKOS',
    text: 'a one bedroom loft with ocean views, a few minutes from La Punta.',
    img: '/img/home/ext-3.jpg',
    alt: 'Terrace edge with vines, steel rails and a curtained window wall',
  },
];

const tiles = [
  { label: 'THE BUILD', img: '/img/home/crew.jpg', alt: 'Crew working on a slab with rebar and foam forms', href: '/' },
  { label: 'THE GUIDE', img: '/img/home/deck.jpg', alt: 'Wooden deck curving over a lawn toward the coast', href: '/guide' },
  { label: 'THE ROUND WINDOWS', img: '/img/home/round-window.jpg', alt: 'A circular window in a concrete wall framing green hillside', href: '/' },
  { label: 'THE PLANS', img: '/img/home/plans.jpg', alt: 'Hands over printed floor plans on site', href: '/' },
];

const ticker = ['la punta', 'built by hand', 'round windows', 'puerto escondido'];
---

<BaseLayout
  title="Contorno | Concept home"
  description="Concept for the Contorno home page."
  header="none"
  footer={false}
  noindex
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400&display=swap" />

  <header class="cx-nav" id="cx-nav">
    <div class="cx-nav-l">
      <a href="#homes">the homes <span class="cx-count">3</span></a>
      <a href="#project">the project</a>
      <a href="/guide">guide</a>
    </div>
    <a href="/concept" class="cx-logo"><span class="cx-dot"></span>contorno</a>
    <div class="cx-nav-r">
      <a href="https://instagram.com/contornocollective" aria-label="Instagram" rel="noopener" target="_blank">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
      <a href="/penthouse" class="cx-btn">reserve <span aria-hidden="true">→</span></a>
    </div>
  </header>

  <!-- Hero: shrinks and fades as the page scrolls -->
  <section class="cx-hero" id="cx-hero">
    <img src="/img/home/drone-1.jpg" alt="Aerial view of the Contorno building above La Punta at sunset" />
    <p class="cx-hero-line">building homes and a collective<br />on la punta, puerto escondido</p>
    <h1 class="cx-hero-word">contorno</h1>
  </section>

  <!-- About: scrolls up over the hero -->
  <section class="cx-about" id="project">
    <div class="cx-about-l">
      <h2>about</h2>
      <p>
        contorno is a small property and a creative collective above La Punta, in Puerto Escondido, Oaxaca.
        Nick Paloukos is building it in concrete, steel and palm, with a local crew, and we document each step as it goes up.
      </p>
      <div class="cx-about-meta">
        <span>SINCE 2024</span>
        <a href="#homes">HOMES</a>
      </div>
    </div>
    <div class="cx-about-r">
      <img src="/img/home/ext-1.jpg" alt="Entrance of the building with agave garden and curtained windows" />
      <div class="cx-sign">
        <span class="cx-dot"></span>
        <p>contorno</p>
        <p class="cx-sign-sub">CONCRETE. STEEL. PALM.</p>
        <p class="cx-sign-sub">NICK PALOUKOS, OWNER AND DEVELOPER</p>
      </div>
    </div>
  </section>

  <!-- Ticker over a photo band -->
  <section class="cx-ticker" id="cx-ticker" aria-hidden="true">
    <img src="/img/home/deck.jpg" alt="" />
    <div class="cx-ticker-track">
      {[0, 1, 2].map(() => (
        <span>{ticker.map((t) => (<><i class="cx-dot"></i>{t}</>))}</span>
      ))}
    </div>
  </section>

  <!-- Homes -->
  <section class="cx-res">
    <div class="cx-res-head">
      <h2 data-reveal>the homes</h2>
      <div class="cx-res-meta">
        <span class="cx-dot"></span>
        <p class="cx-label">COLLECTION I · LA PUNTA</p>
      </div>
      <p class="cx-res-text" data-reveal>
        each home sits inside the same building, with concrete walls, steady light, and a window that looks at the Pacific or the canopy. book direct, with checkout by Prestige.
      </p>
    </div>

    <div class="cx-stack" id="cx-stack">
      <span id="homes" class="cx-anchor"></span>
      {homes.map((h) => (
        <a class="cx-card" href={h.href}>
          <img src={h.img} alt={h.alt} />
          <span class="cx-card-shade"></span>
          <span class="cx-card-coords">{COORDS}</span>
          <span class="cx-card-place">{h.place}</span>
          <h3>{h.name}</h3>
          <span class="cx-card-by"><i class="cx-dot"></i>{h.by}</span>
          <p class="cx-card-text">{h.text}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- The place -->
  <section class="cx-place">
    <div class="cx-place-head">
      <h2 data-reveal>the place</h2>
      <p data-reveal>
        a home on this hill comes with a neighborhood. we keep a guide to the cafes, studios,
        beaches and kitchens we use ourselves, and we credit the people behind each one.
      </p>
    </div>
    <div class="cx-tiles">
      {tiles.map((t) => (
        <a class="cx-tile" href={t.href} data-reveal>
          <img src={t.img} alt={t.alt} loading="lazy" />
          <span class="cx-label">{t.label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Footer -->
  <footer class="cx-foot">
    <div class="cx-foot-grid" data-reveal>
      <div>
        <p class="cx-foot-name">contorno</p>
        <p class="cx-foot-sub">homes, a guide and a build record<br />on La Punta, Puerto Escondido</p>
      </div>
      <div>
        <p class="cx-label">CONTORNO · PUERTO ESCONDIDO, OAXACA</p>
        <p class="cx-label">{COORDS}</p>
        <a class="cx-rust" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL.toUpperCase()}</a>
      </div>
      <div class="cx-foot-links">
        <a href="#project">ABOUT</a>
        <a href="#homes">HOMES</a>
        <a href="/guide">GUIDE</a>
      </div>
      <div class="cx-foot-links">
        <a class="cx-rust" href="https://instagram.com/contornocollective" target="_blank" rel="noopener">Instagram</a>
        <a class="cx-rust" href={`mailto:${CONTACT_EMAIL}`}>Email</a>
      </div>
    </div>
    <div class="cx-bigword" data-reveal><span class="cx-dot"></span>contorno</div>
    <p class="cx-copy">© 2026 Contorno</p>
  </footer>

  <script is:inline>
    (function () {
      var nav = document.getElementById('cx-nav');
      var hero = document.getElementById('cx-hero');
      var ticker = document.getElementById('cx-ticker');
      var cards = [].slice.call(document.querySelectorAll('.cx-card'));
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var queued = false;
      function clamp(v, a, b) { return Math.min(b, Math.max(a, v)); }

      function frame() {
        queued = false;
        var y = window.scrollY, H = window.innerHeight;
        // Hero shrinks to half size and fades out over the first stretch of scroll.
        var p = clamp(y / (H * 0.38), 0, 1);
        if (!reduce) {
          hero.style.transform = 'scale(' + (1 - 0.5 * p) + ')';
          hero.style.opacity = String(clamp(1 - 1.25 * p, 0, 1));
        }
        // Nav is dark over the hero and about, cream after the ticker.
        nav.classList.toggle('is-light', ticker.getBoundingClientRect().top < 60);
        // Each pinned card insets and fades while the next card slides over it.
        if (!reduce) {
          for (var i = 0; i < cards.length - 1; i++) {
            var top = cards[i + 1].getBoundingClientRect().top;
            var q = clamp((H - top) / (H - 76), 0, 1);
            cards[i].style.width = (100 - 14 * q) + '%';
            cards[i].style.opacity = String(1 - 0.65 * q);
          }
        }
      }
      function onScroll() { if (!queued) { queued = true; requestAnimationFrame(frame); } }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      frame();

      // Fade up as things enter the screen.
      var items = [].slice.call(document.querySelectorAll('[data-reveal]'));
      if (!('IntersectionObserver' in window) || reduce) { items.forEach(function (e) { e.classList.add('in'); }); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { threshold: 0.12 });
      items.forEach(function (e, k) { e.style.transitionDelay = ((k % 4) * 70) + 'ms'; io.observe(e); });
    })();
  </script>
</BaseLayout>

<style is:global>
  :root { --cx-bg: #F5F0E8; --cx-ink: #2A2A2A; --cx-rust: #C0583A; --cx-dark: #1d1c1a; --cx-mono: "DM Mono", ui-monospace, Menlo, monospace; }
  html { scroll-behavior: smooth; }
  body { background: var(--cx-bg); }
  .cx-dot { display: inline-block; width: .9em; height: .9em; border-radius: 50%; border: .14em solid currentColor; box-sizing: border-box; vertical-align: -0.05em; flex: none; }
  .cx-label { font-family: var(--cx-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; margin: 0; }
  .cx-rust { color: var(--cx-rust); }
  [data-reveal] { opacity: 0; transform: translateY(30px); transition: opacity .8s ease, transform .8s ease; }
  [data-reveal].in { opacity: 1; transform: none; }

  /* nav: dark over the hero, cream after the ticker */
  .cx-nav { position: fixed; inset: 0 0 auto 0; z-index: 50; height: 60px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 22px; background: var(--cx-dark); color: #F5F0E8; transition: background-color .35s ease, color .35s ease; font-family: var(--cx-mono); }
  .cx-nav.is-light { background: var(--cx-bg); color: var(--cx-ink); }
  .cx-nav a { color: inherit; text-decoration: none; font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; }
  .cx-nav-l { display: flex; gap: 26px; align-items: center; }
  .cx-count { display: inline-block; background: #F5F0E8; color: var(--cx-dark); border-radius: 999px; font-size: 10px; padding: 1px 6px; margin-left: 4px; transition: background-color .35s, color .35s; }
  .cx-nav.is-light .cx-count { background: var(--cx-dark); color: var(--cx-bg); }
  .cx-logo { font-family: "Gabarito", sans-serif; font-size: 22px !important; letter-spacing: -.01em !important; text-transform: lowercase !important; display: inline-flex; align-items: center; gap: 8px; }
  .cx-logo .cx-dot { width: 18px; height: 18px; }
  .cx-nav-r { display: flex; justify-content: flex-end; align-items: center; gap: 20px; }
  .cx-btn { border: 1px solid currentColor; padding: 8px 14px; }
  .cx-btn:hover { background: #F5F0E8; color: var(--cx-dark) !important; }
  .cx-nav.is-light .cx-btn { background: var(--cx-dark); color: var(--cx-bg); border-color: var(--cx-dark); }

  /* hero */
  .cx-hero { position: relative; height: 100svh; min-height: 620px; overflow: hidden; color: #F5F0E8; background: var(--cx-dark); transform-origin: 50% 50%; will-change: transform, opacity; }
  .cx-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cx-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20,18,14,.7), rgba(20,18,14,.05) 55%, rgba(20,18,14,.3)); }
  .cx-hero-line { position: absolute; z-index: 2; left: 22px; bottom: clamp(120px, 24vw, 330px); font-size: clamp(20px, 2.6vw, 34px); line-height: 1.15; font-weight: 300; margin: 0; font-family: "DM Sans", sans-serif; }
  .cx-hero-word { position: absolute; z-index: 2; left: 14px; bottom: -.1em; margin: 0; font-family: "Gabarito", sans-serif; font-weight: 500; font-size: clamp(90px, 25vw, 400px); line-height: .9; letter-spacing: -.03em; text-transform: lowercase; }

  /* about */
  .cx-about { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr 1fr; min-height: 100svh; background: var(--cx-bg); }
  .cx-about-l { padding: 120px 34px 28px 22px; display: flex; flex-direction: column; justify-content: space-between; gap: 40px; }
  .cx-about h2, .cx-res h2, .cx-place h2 { font-family: "Gabarito", sans-serif; font-weight: 400; font-size: clamp(54px, 8vw, 120px); line-height: .95; letter-spacing: -.04em; margin: 0; }
  .cx-about-l p { font-size: clamp(17px, 1.7vw, 24px); line-height: 1.28; max-width: 28em; margin: 0; font-family: "DM Sans", sans-serif; }
  .cx-about-meta { display: flex; justify-content: space-between; font-family: var(--cx-mono); font-size: 11px; letter-spacing: .08em; }
  .cx-about-meta a { color: inherit; text-decoration: underline; text-underline-offset: 4px; }
  .cx-about-r { position: relative; background: var(--cx-rust); overflow: hidden; }
  .cx-about-r img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: multiply; opacity: .95; position: absolute; inset: 0; }
  .cx-sign { position: absolute; left: 22px; bottom: 22px; color: #F5F0E8; font-size: 22px; font-family: "Gabarito", sans-serif; }
  .cx-sign p { margin: 4px 0 0; }
  .cx-sign-sub { font-family: var(--cx-mono); font-size: 11px; letter-spacing: .08em; }

  /* ticker over a photo */
  .cx-ticker { position: relative; z-index: 2; overflow: hidden; height: clamp(220px, 34vw, 380px); display: flex; align-items: center; background: var(--cx-dark); }
  .cx-ticker img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cx-ticker-track { position: relative; display: flex; width: max-content; animation: cx-slide 40s linear infinite; color: var(--cx-dark); }
  .cx-ticker-track span { white-space: nowrap; font-family: "Gabarito", sans-serif; font-weight: 400; font-size: clamp(120px, 24vw, 340px); letter-spacing: -.05em; line-height: 1; padding-right: .5em; }
  .cx-ticker-track i.cx-dot { width: .5em; height: .5em; margin: 0 .35em; border-width: .06em; }
  @keyframes cx-slide { to { transform: translateX(-33.333%); } }
  @media (prefers-reduced-motion: reduce) { .cx-ticker-track { animation: none; } }

  /* homes: cards pin and the next one slides over */
  .cx-res { position: relative; z-index: 2; background: var(--cx-bg); padding: 100px 0 0; }
  .cx-res-head { display: grid; grid-template-columns: 1fr 1fr; padding: 0 22px 60px; gap: 24px; min-height: 52vh; align-content: space-between; }
  .cx-res-head h2 { grid-column: 1 / -1; }
  .cx-res-meta { display: flex; align-items: flex-end; gap: 12px; font-size: 20px; }
  .cx-res-text { margin: 0; font-size: clamp(16px, 1.5vw, 21px); line-height: 1.3; max-width: 28em; justify-self: start; font-family: "DM Sans", sans-serif; }
  .cx-stack { position: relative; padding-bottom: 0; }
  .cx-anchor { position: absolute; top: -80px; }
  .cx-card { position: sticky; top: 76px; display: block; width: 100%; margin: 0 auto 40px; height: min(640px, calc(100svh - 96px)); overflow: hidden; color: #F5F0E8; text-decoration: none; background: var(--cx-dark); }
  .cx-card:last-child { margin-bottom: 0; }
  .cx-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cx-card-shade { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,.28), rgba(0,0,0,.05) 40%, rgba(0,0,0,.35)); }
  .cx-card > span, .cx-card > h3, .cx-card > p { position: absolute; }
  .cx-card-coords { left: 22px; top: 28%; font-family: var(--cx-mono); font-size: 11.5px; letter-spacing: .06em; line-height: 1.5; max-width: 9em; }
  .cx-card-place { left: 50%; top: 22px; font-family: var(--cx-mono); font-size: 11.5px; letter-spacing: .06em; }
  .cx-card h3 { left: 50%; top: 56px; margin: 0; font-family: "Gabarito", sans-serif; font-weight: 400; font-size: clamp(48px, 7.4vw, 118px); line-height: .94; letter-spacing: -.045em; max-width: 8em; }
  .cx-card-by { left: 22px; bottom: 22px; display: inline-flex; align-items: center; gap: 10px; font-family: var(--cx-mono); font-size: 11px; letter-spacing: .06em; max-width: 14em; line-height: 1.4; }
  .cx-card-by .cx-dot { width: 26px; height: 26px; border-width: 2px; opacity: .85; }
  .cx-card-text { left: 62%; right: 22px; bottom: 22px; margin: 0; font-size: clamp(14px, 1.45vw, 20px); line-height: 1.2; font-family: "DM Sans", sans-serif; }

  /* the place */
  .cx-place { position: relative; z-index: 2; background: var(--cx-bg); padding: 120px 22px 100px; }
  .cx-place-head { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 80px; align-items: end; }
  .cx-place-head p { margin: 0; max-width: 28em; font-size: clamp(16px, 1.5vw, 21px); line-height: 1.3; font-family: "DM Sans", sans-serif; }
  .cx-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; align-items: start; }
  .cx-tile { color: inherit; text-decoration: none; display: block; }
  .cx-tile img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block; margin-bottom: 12px; }
  .cx-tile:nth-child(even) { margin-top: 70px; }
  .cx-tile:hover .cx-label { color: var(--cx-rust); }

  /* footer */
  .cx-foot { position: relative; z-index: 2; background: var(--cx-bg); padding: 40px 22px 24px; overflow: hidden; }
  .cx-foot-grid { display: grid; grid-template-columns: 1.2fr 1.4fr .8fr .6fr; gap: 30px; align-items: start; }
  .cx-foot p { margin: 0 0 6px; }
  .cx-foot-name { font-family: "Gabarito", sans-serif; font-size: 26px; }
  .cx-foot-sub { font-size: 13px; color: #6d6a63; line-height: 1.35; font-family: "DM Sans", sans-serif; }
  .cx-foot a { display: block; text-decoration: none; color: inherit; font-family: var(--cx-mono); font-size: 11px; letter-spacing: .08em; margin-bottom: 6px; }
  .cx-foot a.cx-rust { color: var(--cx-rust); }
  .cx-bigword { display: flex; align-items: center; gap: .08em; font-family: "Gabarito", sans-serif; font-weight: 500; font-size: clamp(80px, 23vw, 360px); line-height: 1; letter-spacing: -.04em; margin: 50px 0 10px; white-space: nowrap; }
  .cx-bigword .cx-dot { width: .6em; height: .6em; border-width: .07em; }
  .cx-copy { font-family: var(--cx-mono); font-size: 11px; color: #6d6a63; margin: 0; }

  @media (max-width: 800px) {
    .cx-nav { grid-template-columns: auto 1fr auto; padding: 0 14px; }
    .cx-nav-l a:not(:first-child) { display: none; }
    .cx-logo { justify-self: center; }
    .cx-nav-r a:first-child { display: none; }
    .cx-about, .cx-place-head { grid-template-columns: 1fr; }
    .cx-about-r { min-height: 70vw; }
    .cx-about-l { padding-top: 90px; }
    .cx-res-head { grid-template-columns: 1fr; min-height: 0; gap: 28px; }
    .cx-card h3 { left: 22px; top: 52px; }
    .cx-card-place { left: 22px; top: 22px; }
    .cx-card-coords { display: none; }
    .cx-card-text { left: 22px; right: 22px; bottom: 64px; }
    .cx-tiles { grid-template-columns: 1fr 1fr; }
    .cx-tile:nth-child(even) { margin-top: 30px; }
    .cx-foot-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
