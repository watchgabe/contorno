---
import BaseLayout from '../layouts/BaseLayout.astro';

const CONTACT_EMAIL = 'hello@contornocollective.com';
const COORDS = '15.8442° N, 97.0418° W';

const homes = [
  {
    href: '/penthouse',
    name: 'la escultura',
    unit: 'Penthouse',
    meaning: 'The Sculptor',
    soon: false,
    text: 'two bedrooms and a private terrace overlooking La Punta on the top floor of an eight-apartment building',
    img: '/img/home/drone-2.jpg',
    alt: 'Aerial view of the Contorno building with planted terraces',
  },
  {
    href: '/homes/la-valquiria',
    name: 'la valquiria',
    unit: 'Loft 5',
    meaning: 'The Valkyrie',
    soon: false,
    text: 'a one bedroom loft with a round window, a glass block wall behind the bed, and a deck over the trees',
    img: '/img/la-valquiria/4.jpg',
    alt: 'The wooden deck outside the loft with two chairs and a view over the trees',
  },
  {
    href: '/homes/la-artista',
    name: 'la artista',
    unit: 'Loft 1',
    meaning: 'The Artist',
    soon: true,
    text: 'a one bedroom loft on a planted courtyard, with a double height living room',
    img: '/img/la-artista/1.jpg',
    alt: 'The entrance of the loft behind a red steel frame, with plants outside',
  },
  {
    href: '/homes/la-poeta',
    name: 'la poeta',
    unit: 'Loft 6',
    meaning: 'The Poet',
    soon: true,
    text: 'a one bedroom loft with an orange sofa and glass doors to a deck',
    img: '/img/la-poeta/1.jpg',
    alt: 'The living room with an orange sofa and a round window in the concrete wall',
  },
];

const tiles = [
  { label: 'THE BUILD', img: '/img/home/crew.jpg', alt: 'Crew working on a slab with rebar and foam forms', href: '/build' },
  { label: 'RESIDENCY', img: '/img/home/plans.jpg', alt: 'Hands over printed floor plans on site', href: '/artist-residency' },
  { label: 'GUIDE', img: '/img/home/deck.jpg', alt: 'Wooden deck curving over a lawn toward the coast', href: '/guide' },
  { label: 'INSPIRATION', img: '/img/home/round-window.jpg', alt: 'A circular window in a concrete wall framing green hillside', href: '/inspiration' },
];

const heroImages = [
  { src: '/img/home/drone-1.jpg', alt: 'Aerial view of the Contorno building above La Punta at sunset' },
  { src: '/img/home/drone-3.jpg', alt: '' },
  { src: '/img/home/ext-1.jpg', alt: '' },
  { src: '/img/home/drone-2.jpg', alt: '' },
  { src: '/img/home/ext-2.jpg', alt: '' },
  { src: '/img/home/ext-3.jpg', alt: '' },
];

---

<BaseLayout
  noindex
  title="Contorno | Column mockup"
  description="Homes, a guide and a build record on La Punta, Puerto Escondido, Oaxaca."
  navAuto={false}
>

  <!-- Hero: shrinks and fades as the page scrolls -->
  <section class="cx-hero">
    <div class="cx-hero-in" id="cx-hero">
      <!-- Slow zoom and fade between photos. A video can replace this later. -->
      <div class="cx-kb" id="cx-kb">
        {heroImages.map((h, i) => (
          <img class={`cx-kb-img${i === 0 ? ' on' : ''}`} src={h.src} alt={i === 0 ? h.alt : ''} aria-hidden={i === 0 ? undefined : 'true'} loading={i === 0 ? 'eager' : 'lazy'} />
        ))}
      </div>
      <span class="cx-hero-coords">15.8442° N<br />97.0418° W</span>
      <span class="cx-hero-tag">PUERTO ESCONDIDO · 2026</span>
      <h1 class="cx-hero-word">contorno</h1>
    </div>
  </section>

  <!-- About: scrolls up over the hero -->
  <section class="cx-about" id="project">
    <div class="cx-about-l">
      <h2>about</h2>
      <p>
        contorno is a small property and a creative collective above La Punta, in Puerto Escondido, Oaxaca.
        Nick Paloukos is building it in concrete, steel and palm, with a local crew, and we document each step as it goes up.
      </p>
      <div class="cx-about-meta">
        <span>SINCE 2024</span>
        <a href="/build">THE BUILD</a>
      </div>
    </div>
    <div class="cx-about-r">
      <img src="/img/home/ext-1.jpg" alt="Entrance of the building with agave garden and curtained windows" />
      <div class="cx-sign">
        <span class="cx-dot"></span>
        <p>contorno</p>
        <p class="cx-sign-sub">CONCRETE. STEEL. PALM.</p>
        <p class="cx-sign-sub">NICK PALOUKOS, OWNER AND DEVELOPER</p>
      </div>
    </div>
  </section>

  <!-- Homes -->
  <section class="cx-res">
    <div class="cx-res-head" id="homes">
      <h2 data-reveal>the homes</h2>
      <p class="cx-res-text" data-reveal>
        each home sits inside the same building, with concrete walls, steady light, and a window that looks at the Pacific or the canopy. book direct, with checkout by Prestige.
      </p>
    </div>

    <div class="cx-stack" id="cx-stack">
      {homes.map((h) => (
        <a class="cx-card" href={h.href}>
          <img src={h.img} alt={h.alt} />
          <span class="cx-card-shade"></span>
          <span class="cx-card-coords">{COORDS}</span>
          <span class="cx-card-by"><i class="cx-dot"></i>{h.by}</span>
          <span class="cx-card-info">
            <h3 class={h.long ? 'long' : ''}>{h.name}</h3>
            <p class="cx-card-line">{h.unit} | {h.meaning} ({h.soon ? 'coming soon' : 'available now'})</p>
            <p class="cx-card-text">{h.text}</p>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- The place -->
  <section class="cx-place">
    <div class="cx-place-head">
      <h2 data-reveal>the place</h2>
      <p data-reveal>
        a home on this hill comes with a neighborhood. we keep a guide to the cafes, studios,
        beaches and kitchens we use ourselves, and we credit the people behind each one.
      </p>
    </div>
    <div class="cx-tiles">
      {tiles.map((t) => (
        <a class="cx-tile" href={t.href} data-reveal>
          <img src={t.img} alt={t.alt} loading="lazy" />
          <span class="cx-label">{t.label}</span>
        </a>
      ))}
    </div>
  </section>

    <script is:inline>
    (function () {
      var nav = document.getElementById('cx-nav');
      var hero = document.getElementById('cx-hero');
      var homesSection = document.querySelector('.cx-res');
      var cards = [].slice.call(document.querySelectorAll('.cx-card'));
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var queued = false;
      function clamp(v, a, b) { return Math.min(b, Math.max(a, v)); }

      function frame() {
        queued = false;
        var y = window.scrollY, H = window.innerHeight;
        // Hero shrinks to half size and fades out over the first stretch of scroll.
        var p = clamp(y / (H * 0.38), 0, 1);
        if (!reduce) {
          hero.style.transform = 'scale(' + (1 - 0.5 * p) + ')';
          hero.style.opacity = String(clamp(1 - 1.25 * p, 0, 1));
        }
        // Nav is cream on the framed hero, dark while scrolling through about, cream again from the homes on.
        nav.classList.toggle('is-dark', y > 24 && homesSection.getBoundingClientRect().top >= 60);
        // Each pinned card insets and fades only while the next card slides over it.
        // Once the next card fully covers it, the card is hidden so nothing shows through.
        if (!reduce) {
          for (var i = 0; i < cards.length - 1; i++) {
            var cardH = cards[i].offsetHeight;
            var top = cards[i + 1].getBoundingClientRect().top;
            var q = clamp((60 + cardH + 40 - top) / (cardH + 40), 0, 1);
            cards[i].style.width = (100 - 14 * q) + '%';
            cards[i].style.opacity = String(1 - 0.65 * q);
            cards[i].style.visibility = q >= 0.999 ? 'hidden' : 'visible';
          }
        }
      }
      function onScroll() { if (!queued) { queued = true; requestAnimationFrame(frame); } }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      frame();

      // Hero: slow zoom, then a slow fade to the next photo.
      var kb = [].slice.call(document.querySelectorAll('.cx-kb-img'));
      if (kb.length > 1 && !reduce) {
        var cur = 0;
        setInterval(function () {
          var next = (cur + 1) % kb.length;
          kb[cur].classList.remove('on'); kb[cur].classList.add('out');
          kb[next].classList.remove('out'); kb[next].classList.add('on');
          var old = kb[cur];
          setTimeout(function () { old.classList.remove('out'); }, 2200);
          cur = next;
        }, 6500);
      }

      // Fade up as things enter the screen.
      var items = [].slice.call(document.querySelectorAll('[data-reveal]'));
      if (!('IntersectionObserver' in window) || reduce) { items.forEach(function (e) { e.classList.add('in'); }); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { threshold: 0.12 });
      items.forEach(function (e, k) { e.style.transitionDelay = ((k % 4) * 70) + 'ms'; io.observe(e); });
    })();
  </script>
</BaseLayout>

<style is:global>
  :root { --cx-bg: #F5F0E8; --cx-ink: #2A2A2A; --cx-rust: #C0583A; --cx-dark: #1d1c1a; --cx-mono: "DM Mono", ui-monospace, Menlo, monospace; }
  html { scroll-behavior: smooth; }
  body { background: var(--cx-bg); }
  .cx-dot { display: inline-block; width: .9em; height: .9em; border-radius: 50%; border: .14em solid currentColor; box-sizing: border-box; vertical-align: -0.05em; flex: none; }
  .cx-label { font-family: var(--cx-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; margin: 0; }
  .cx-rust { color: var(--cx-rust); }
  [data-reveal] { opacity: 0; transform: translateY(30px); transition: opacity .8s ease, transform .8s ease; }
  [data-reveal].in { opacity: 1; transform: none; }

  /* hero: framed photo with a cream border, like the current home page */
  .cx-hero { height: 100svh; min-height: 620px; padding: 60px 14px 14px; background: var(--cx-bg); }
  .cx-hero-in { position: relative; height: 100%; border-radius: 12px; overflow: hidden; color: #F5F0E8; background: var(--cx-dark); transform-origin: 50% 50%; will-change: transform, opacity; }
  .cx-kb, .cx-kb-img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cx-kb-img { object-fit: cover; opacity: 0; transition: opacity 1.8s ease; transform-origin: 55% 50%; }
  .cx-kb-img.on { opacity: 1; animation: cx-kb 13s ease-out forwards; }
  .cx-kb-img.out { opacity: 0; animation: cx-kb 13s ease-out forwards; }
  @keyframes cx-kb { from { transform: scale(1); } to { transform: scale(1.1) translate(-1%, -1%); } }
  @media (prefers-reduced-motion: reduce) { .cx-kb-img.on, .cx-kb-img.out { animation: none; } }
  .cx-hero-in::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20,18,14,.55), rgba(20,18,14,0) 45%, rgba(20,18,14,.25)); }
  .cx-hero-coords, .cx-hero-tag { position: absolute; z-index: 2; top: 28px; font-family: "DM Sans", sans-serif; font-size: 11px; letter-spacing: .14em; line-height: 1.6; opacity: .85; }
  .cx-hero-coords { left: 34px; }
  .cx-hero-tag { right: 34px; }
  .cx-hero-word { position: absolute; z-index: 2; left: 34px; bottom: 30px; margin: 0; font-family: "Gabarito", sans-serif; font-weight: 400; font-size: clamp(64px, 12vw, 210px); line-height: .9; letter-spacing: -.035em; text-transform: lowercase; }

  /* about */
  .cx-about { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr 1fr; min-height: 88svh; background: var(--cx-bg); }
  .cx-about-l { padding: 120px 34px 28px 22px; display: flex; flex-direction: column; justify-content: flex-start; gap: 26px; }
  .cx-about-meta { margin-top: auto; }
  .cx-about h2, .cx-res h2, .cx-place h2 { font-family: "Gabarito", sans-serif; font-weight: 400; font-size: clamp(54px, 8vw, 120px); line-height: .95; letter-spacing: -.04em; margin: 0; }
  .cx-about-l p { font-size: clamp(17px, 1.7vw, 24px); line-height: 1.28; max-width: 28em; margin: 0; font-family: "DM Sans", sans-serif; }
  .cx-about-meta { display: flex; justify-content: space-between; font-family: var(--cx-mono); font-size: 11px; letter-spacing: .08em; }
  .cx-about-meta a { color: inherit; text-decoration: underline; text-underline-offset: 4px; }
  .cx-about-r { position: relative; background: var(--cx-rust); overflow: hidden; }
  .cx-about-r img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: multiply; opacity: .95; position: absolute; inset: 0; }
  .cx-sign { position: absolute; left: 22px; bottom: 22px; color: #F5F0E8; font-size: 22px; font-family: "Gabarito", sans-serif; }
  .cx-sign p { margin: 4px 0 0; }
  .cx-sign-sub { font-family: var(--cx-mono); font-size: 11px; letter-spacing: .08em; }

  /* homes: cards pin and the next one slides over */
  .cx-res { position: relative; z-index: 2; background: var(--cx-bg); padding: calc(18vh + 90px) 0 0; }
  .cx-res-head { display: grid; grid-template-columns: 1fr 1fr; padding: 0 22px 26px; gap: 24px; align-items: end; scroll-margin-top: 18vh; }
  .cx-res-text { margin: 0 0 6px; font-size: clamp(16px, 1.5vw, 21px); line-height: 1.3; max-width: 28em; justify-self: start; font-family: "DM Sans", sans-serif; }
  .cx-stack { position: relative; padding-bottom: 0; }
  .cx-anchor { position: absolute; top: -80px; }
  .cx-card { position: sticky; top: 76px; display: block; width: 100%; margin: 0 auto 40px; height: min(640px, calc(100svh - 96px)); overflow: hidden; color: #F5F0E8; text-decoration: none; background: var(--cx-dark); }
  .cx-card:last-child { margin-bottom: 0; }
  .cx-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cx-card-shade { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,.28), rgba(0,0,0,.05) 40%, rgba(0,0,0,.35)); }
  .cx-card > span { position: absolute; }
  .cx-card-coords { left: 22px; top: 22px; font-family: var(--cx-mono); font-size: 11.5px; letter-spacing: .06em; line-height: 1.5; max-width: 9em; }
  .cx-card-by { right: 22px; bottom: 22px; text-align: left; display: inline-flex; align-items: center; gap: 10px; font-family: var(--cx-mono); font-size: 11px; letter-spacing: .06em; max-width: 14em; line-height: 1.4; }
  .cx-card-soon { right: 22px; top: 22px; font-family: var(--cx-mono); font-size: 11px; letter-spacing: .08em; border: 1px solid currentColor; padding: 6px 10px; border-radius: 999px; }
  .cx-card-by .cx-dot { width: 26px; height: 26px; border-width: 2px; opacity: .85; }
  .cx-card-info { left: 22px; right: 22px; bottom: 22px; display: block; }
  /* Same size for every title, left aligned, and the same size as the contorno wordmark on the hero. */
  .cx-card { container-type: inline-size; }
  .cx-card h3 { margin: 0 0 14px; font-family: "Gabarito", sans-serif; font-weight: 500; font-size: clamp(64px, 12vw, 210px); line-height: .92; letter-spacing: -.04em; text-transform: lowercase; white-space: nowrap; }
  .cx-card-line { max-width: 38cqw; margin: 0 0 4px; font-weight: 700; font-size: clamp(14px, 1.45vw, 20px); line-height: 1.2; font-family: "DM Sans", sans-serif; }
  .cx-card-text { max-width: 38cqw; margin: 0; font-size: clamp(14px, 1.45vw, 20px); line-height: 1.2; font-family: "DM Sans", sans-serif; }

  /* the place: four staggered tiles */
  .cx-place { position: relative; z-index: 2; background: var(--cx-bg); padding: 110px 22px 100px; }
  .cx-place-head { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 80px; align-items: end; }
  .cx-place-head p { margin: 0; max-width: 28em; font-size: clamp(16px, 1.5vw, 21px); line-height: 1.3; font-family: "DM Sans", sans-serif; }
  .cx-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; align-items: start; }
  .cx-tile { color: inherit; text-decoration: none; display: block; }
  .cx-tile img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block; margin-bottom: 12px; }
  .cx-tile:nth-child(even) { margin-top: 70px; }
  .cx-tile:hover .cx-label { color: var(--cx-rust); }
  .cx-label { font-family: var(--cx-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; margin: 0; }

  @media (max-width: 800px) {
    .cx-about { grid-template-columns: 1fr; }
    .cx-about-r { min-height: 70vw; }
    .cx-about-l { padding-top: 90px; }
    .cx-res-head { grid-template-columns: 1fr; gap: 18px; }
    .cx-card-coords { display: none; }
    .cx-card-info { left: 22px; right: 22px; bottom: 64px; }
    .cx-card h3 { font-size: calc((100cqw - 44px) / 5.2); }
    .cx-card-text, .cx-card-line { max-width: none; }
    .cx-card-by { right: auto; left: 22px; text-align: left; }
    .cx-place-head { grid-template-columns: 1fr; gap: 20px; margin-bottom: 40px; }
    .cx-tiles { grid-template-columns: 1fr 1fr; }
    .cx-tile:nth-child(even) { margin-top: 30px; }
  }
</style>

<style is:global>
  /* Column mockup: about and the homes share one centered column, 85% wide. Cards are 7:5, a little taller than the photos, and never taller than the screen. */
  .cx-about { padding: 0 7.5vw; }
  .cx-about-l { padding-left: 0; }
  .cx-res .cx-res-head { width: 85vw; margin: 0 auto; padding-left: 0; padding-right: 0; }
  .cx-stack { width: 85vw; margin: 0 auto; }
  .cx-res .cx-res-head h2, .cx-about h2 { margin-left: -.04em; }
  .cx-res .cx-res-text { justify-self: end; text-align: left; }
  .cx-card { top: 60px; aspect-ratio: auto; height: min(calc(85vw / 1.4), calc(100svh - 72px)); }
  .cx-card h3 { font-size: calc(100cqw / 8.3); }
  .cx-card-info { left: 22px; right: 22px; }
  .cx-card-text, .cx-card-line { max-width: none; }
  @media (max-width: 760px) {
    .cx-about { padding: 0 22px; }
    .cx-res-head, .cx-stack { width: calc(100% - 44px); }
    .cx-card { height: min(calc((100vw - 44px) * 4 / 3), calc(100svh - 72px)); }
    .cx-card h3 { font-size: calc((100cqw - 44px) / 5.2); }
  }
</style>
