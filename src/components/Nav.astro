---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}${path}`;
const CONTACT_EMAIL = 'hello@contornocollective.com';
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (p: string) => path === p || (p !== '/' && path.startsWith(p));
---

<nav id="main-nav">
  <div class="nav-left">
    <a href={link('/')} class={isActive('/') && path === '' ? 'active' : ''}>the project</a>
    <a href={link('/artist-residency')} class={isActive('/artist-residency') ? 'active' : ''}>residency</a>
    <a href={link('/stay')} class={isActive('/stay') ? 'active' : ''}>stay</a>
    <a href={link('/guide')} class={isActive('/guide') ? 'active' : ''}>guide</a>
  </div>
  <a href={link('/')} class="nav-logo">contorno</a>
  <div class="nav-right">
    <a href="https://instagram.com/contornocollective" class="nav-ig" aria-label="Contorno on Instagram" target="_blank" rel="noopener">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
    </a>
    <a href={`mailto:${CONTACT_EMAIL}`} class="nav-cta">contact →</a>
  </div>
</nav>

