---
import { homes } from '../data/homes';

interface Props {
  /** Turn dark after a small scroll. The home page controls this itself. */
  autoDark?: boolean;
}
const { autoDark = true } = Astro.props;
const count = homes.length;
---

<header class="cx-nav" id="cx-nav" data-auto={autoDark ? 'true' : 'false'}>
  <div class="cx-nav-l">
    <a href="/#homes">the homes <span class="cx-count">{count}</span></a>
    <a href="/build">the build</a>
    <a href="/artist-residency">residency</a>
    <a href="/guide" target="_blank" rel="noopener">guide</a>
  </div>
  <a href="/" class="cx-logo"><span class="cx-dot"></span>contorno</a>
  <div class="cx-nav-r">
    <a href="https://instagram.com/contornocollective" aria-label="Instagram" rel="noopener" target="_blank">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
    </a>
    <a href="/penthouse" class="cx-btn">reserve <span aria-hidden="true">→</span></a>
  </div>
</header>

<script is:inline>
  (function () {
    var nav = document.getElementById('cx-nav');
    if (!nav || nav.dataset.auto !== 'true') return;
    function update() { nav.classList.toggle('is-dark', window.scrollY > 24); }
    update();
    window.addEventListener('scroll', update, { passive: true });
  })();
</script>

<style is:global>
  .cx-nav { position: fixed; inset: 0 0 auto 0; z-index: 100; height: 60px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 22px; background: var(--cx-bg); color: var(--cx-ink); transition: background-color .35s ease, color .35s ease; font-family: var(--cx-mono); }
  .cx-nav.is-dark { background: var(--cx-dark); color: #F5F0E8; }
  .cx-nav a { color: inherit; text-decoration: none; font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; }
  .cx-nav-l { display: flex; gap: 26px; align-items: center; }
  .cx-count { display: inline-block; background: var(--cx-dark); color: var(--cx-bg); border-radius: 999px; font-size: 10px; padding: 1px 6px; margin-left: 4px; transition: background-color .35s, color .35s; }
  .cx-nav.is-dark .cx-count { background: #F5F0E8; color: var(--cx-dark); }
  .cx-logo { font-family: "Gabarito", sans-serif; font-size: 22px !important; letter-spacing: -.01em !important; text-transform: lowercase !important; display: inline-flex; align-items: center; gap: 8px; }
  .cx-logo .cx-dot { width: 18px; height: 18px; }
  .cx-nav-r { display: flex; justify-content: flex-end; align-items: center; gap: 20px; }
  .cx-btn { border: 1px solid var(--cx-dark); background: var(--cx-dark); color: var(--cx-bg) !important; padding: 8px 14px; }
  .cx-nav.is-dark .cx-btn { background: transparent; color: #F5F0E8 !important; border-color: rgba(245,240,232,.6); }
  .cx-nav.is-dark .cx-btn:hover { background: #F5F0E8; color: var(--cx-dark) !important; }
  @media (max-width: 860px) {
    .cx-nav { grid-template-columns: auto 1fr auto; padding: 0 14px; }
    .cx-nav-l { gap: 14px; }
    .cx-nav-l a:nth-child(n+3) { display: none; }
    .cx-logo { justify-self: center; }
    .cx-nav-r a:first-child { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .cx-nav, .cx-count { transition: none; } }
</style>
