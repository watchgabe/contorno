---
const CONTACT_EMAIL = 'hello@contornocollective.com';
const COORDS = '15.8442° N, 97.0418° W';
---

<div class="cx-foot">
  <div class="cx-foot-grid">
    <div>
      <p class="cx-foot-name">contorno</p>
      <p class="cx-foot-sub">homes, a guide and a build record<br />on La Punta, Puerto Escondido</p>
    </div>
    <div>
      <p class="cx-foot-mono">CONTORNO · PUERTO ESCONDIDO, OAXACA</p>
      <p class="cx-foot-mono">{COORDS}</p>
      <a class="cx-foot-mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL.toUpperCase()}</a>
    </div>
    <div class="cx-foot-links">
      <a href="/#homes">HOMES</a>
      <a href="/build">THE BUILD</a>
      <a href="/artist-residency">RESIDENCY</a>
      <a href="/guide">GUIDE</a>
      <a href="/inspiration">INSPIRATION</a>
    </div>
    <div class="cx-foot-social">
      <a href="https://instagram.com/contornocollective" target="_blank" rel="noopener">Instagram</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>Email</a>
    </div>
  </div>
</div>

<style is:global>
  .cx-foot { position: relative; z-index: 2; background: var(--cx-bg); padding: 34px 20px 70px; }
  .cx-foot-grid { display: grid; grid-template-columns: 1.3fr 1.3fr 1fr auto; gap: 30px; align-items: start; }
  .cx-foot p { margin: 0; }
  .cx-foot-name { font-family: "Gabarito", sans-serif; font-weight: 400; font-size: 26px; letter-spacing: -.02em; line-height: 1.1; }
  .cx-foot-sub { margin-top: 12px !important; font-size: 16px; line-height: 1.25; color: #7b776f; font-family: "DM Sans", sans-serif; }
  .cx-foot-mono { font-family: var(--cx-mono); font-size: 14px; line-height: 1.5; letter-spacing: .02em; }
  .cx-foot-mail { display: block; margin-top: 18px; color: var(--cx-rust); font-family: var(--cx-mono); font-size: 14px; letter-spacing: .02em; text-decoration: none; }
  .cx-foot-links { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .cx-foot-links a { color: inherit; font-family: var(--cx-mono); font-size: 14px; letter-spacing: .02em; text-decoration: underline dotted; text-underline-offset: 4px; }
  .cx-foot-social { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .cx-foot-social a { color: var(--cx-rust); text-decoration: none; font-family: "DM Sans", sans-serif; font-size: 20px; line-height: 1.1; }
  @media (max-width: 800px) {
    .cx-foot-grid { grid-template-columns: 1fr 1fr; }
    .cx-foot { padding-bottom: 40px; }
  }
</style>
